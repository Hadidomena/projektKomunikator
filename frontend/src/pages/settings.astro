---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/app.css';
---
<style>
    .back-btn { background: rgba(255,255,255,0.2); color: var(--header-text); border: none; padding: 8px 16px; border-radius: 5px; cursor: pointer; text-decoration: none; display: inline-block; }
    .back-btn:hover { background: rgba(255,255,255,0.3); }
    .container { max-width: 1000px; margin: 30px auto; padding: 0 20px; }
    .section { margin-bottom: 20px; }
    .section h2 { margin-bottom: 15px; font-size: 20px; }
    .section p { color: var(--text-muted); margin-bottom: 15px; font-size: 14px; }
    .form-group { margin-bottom: 15px; }
    button { background: var(--accent-gradient); color: var(--text-on-accent); border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-size: 14px; font-weight: 500; }
    button:hover { opacity: 0.9; }
    button:disabled { opacity: 0.6; cursor: not-allowed; }
    button.danger { background: var(--danger-gradient); }
    .qr-code { text-align: center; margin: 20px 0; }
    .login-history { margin-top: 15px; max-height: 400px; overflow-y: auto; }
    .login-item { padding: 10px; background: var(--surface-muted); border-radius: 5px; margin-bottom: 8px; font-size: 13px; }
    .login-item .ip { font-weight: 600; color: var(--accent); }
    .login-item .date { color: var(--text-subtle); font-size: 12px; }
    .login-item .device { color: var(--text-muted); font-size: 12px; margin-top: 3px; }
    .login-item .new-device { display: inline-block; background: var(--warning-bg); color: var(--warning-text); padding: 2px 8px; border-radius: 3px; font-size: 11px; font-weight: 600; margin-top: 5px; }
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-top: 15px; }
    .stat-card { background: var(--surface-muted); padding: 15px; border-radius: 5px; text-align: center; }
    .stat-value { font-size: 32px; font-weight: bold; color: var(--accent); }
    .stat-label { font-size: 12px; color: var(--text-muted); margin-top: 5px; text-transform: uppercase; }
</style>

<BaseLayout title="Settings - Communicator">
  <div class="header">
    <h1>⚙️ Settings</h1>
    <a href="/dashboard" class="back-btn">← Back to Dashboard</a>
  </div>

  <div class="container">
    <div class="section card">
      <h2>🔐 Two-Factor Authentication (2FA)</h2>
      <p>Enhance your account security with TOTP-based 2FA</p>

      <div id="totp-disabled" class="hidden">
        <button id="enable2faBtn">Enable 2FA</button>
        <div id="enable2faMessage" class="message"></div>
      </div>

      <div id="totp-setup" class="hidden">
        <p><strong>Step 1:</strong> Add this secret key to your authenticator app (Google Authenticator, Authy, etc.)</p>
        <div class="qr-code" id="qrCodeContainer"></div>
        <p><strong>Step 2:</strong> Enter the 6-digit code from your app to verify</p>
        <div class="form-group">
          <input type="text" id="verifyCode" placeholder="Enter 6-digit code" maxlength="6" pattern="[0-9]{6}" />
        </div>
        <button id="verify2faBtn">Verify and Enable 2FA</button>
        <div id="verify2faMessage" class="message"></div>
      </div>

      <div id="totp-enabled" class="hidden">
        <p class="message success">✓ 2FA is currently enabled for your account</p>
        <button class="danger" id="disable2faBtn">Disable 2FA</button>
        <div id="disable2faMessage" class="message"></div>
      </div>
    </div>

    <div class="section card">
      <h2>📊 Login History</h2>
      <p>Recent login attempts from your account</p>
      <div class="login-history" id="loginHistory">
        <p style="color: var(--text-subtle);">Loading...</p>
      </div>
    </div>

    <div class="section card">
      <h2>🍯 Security Stats</h2>
      <p>Bot detection statistics</p>
      <div class="stats" id="honeypotStats">
        <p style="color: var(--text-subtle);">Loading...</p>
      </div>
    </div>
  </div>

  <script>import '../scripts/settings';</script>
</BaseLayout>
