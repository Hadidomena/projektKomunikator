---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/auth.css';
---
<style>
    h1 { margin-bottom: 30px; }
    .totp-section { display: none; margin-top: 20px; padding-top: 20px; border-top: 1px solid #ddd; }
    .totp-section.active { display: block; }
</style>

<BaseLayout title="Login - Communicator">
  <div class="container">
    <h1>🔐 Login</h1>
    <form id="loginForm">
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autocomplete="email" />
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password" />
      </div>
      
      <!-- Honeypot fields - hidden from real users but visible to bots -->
      <div class="hp-field" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <div class="hp-field" aria-hidden="true">
        <label for="phone">Phone Number</label>
        <input type="tel" id="phone" name="phone" tabindex="-1" autocomplete="off" />
      </div>
      <div class="hp-field" aria-hidden="true">
        <label for="middle_name">Middle Name</label>
        <input type="text" id="middle_name" name="middle_name" tabindex="-1" autocomplete="off" />
      </div>
      
      <button type="submit" id="loginBtn">Login</button>
      
      <div class="totp-section" id="totpSection">
        <div class="form-group">
          <label for="totpCode">2FA Code (TOTP)</label>
          <input type="text" id="totpCode" name="totpCode" placeholder="Enter 6-digit code" maxlength="6" pattern="[0-9]{6}" />
        </div>
        <button type="button" id="verifyTotpBtn">Verify 2FA</button>
      </div>
    </form>
    <div id="message"></div>
    <div class="links">
      <a href="/register">Don't have an account? Register</a><br>
      <a href="/reset-password">Forgot password?</a><br>
      <a href="/">← Back to home</a>
    </div>
  </div>

  <script>import '../scripts/login';</script>
</BaseLayout>
