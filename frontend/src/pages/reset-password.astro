---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/auth.css';
---
<style>
    h1 { margin-bottom: 10px; }
    .subtitle { color: #666; margin-bottom: 30px; text-align: center; font-size: 14px; }
    .message { display: none; }
    .message.error, .message.success { display: block; }
    .verify-section { display: none; }
    .verify-section.active { display: block; }
</style>

<BaseLayout title="Reset Password - Communicator">
  <div class="container">
    <h1>🔑 Reset Password</h1>
    <p class="subtitle">Enter your email to receive a reset link</p>
    
    <div id="requestSection">
      <form id="requestForm">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>
        <button type="submit" id="requestBtn">Send Reset Link</button>
      </form>
    </div>

    <div id="verifySection" class="verify-section">
      <form id="verifyForm">
        <div class="form-group">
          <label for="token">Reset Token</label>
          <input type="text" id="token" name="token" required placeholder="Enter token from email" />
        </div>
        <div class="form-group">
          <label for="newPassword">New Password</label>
          <input type="password" id="newPassword" name="newPassword" required />
        </div>
        <button type="submit" id="verifyBtn">Reset Password</button>
      </form>
    </div>

    <div id="message"></div>
    
    <div class="links">
      <a href="/login">← Back to login</a>
    </div>
  </div>

  <script>import '../scripts/reset-password';</script>
</BaseLayout>
