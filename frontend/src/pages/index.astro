---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<style>
  body { font-family: sans-serif; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; background-color: #f0f2f5; margin: 0; }
  h1 { color: #333; }
  div { display: flex; gap: 20px; margin-top: 20px; }
  a { padding: 10px 20px; border-radius: 4px; text-decoration: none; color: white; font-weight: bold; }
  .login { background-color: #007bff; }
  .register { background-color: #28a745; }
</style>

<BaseLayout title="Welcome">
  <h1>Welcome to the Communicator App</h1>
  <div>
    <a href="/login" class="login">Log In</a>
    <a href="/register" class="register">Register</a>
  </div>
</BaseLayout>
