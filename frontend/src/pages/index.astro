---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<style>
  body { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; background-color: var(--bg); margin: 0; }
  div { display: flex; gap: 20px; margin-top: 20px; }
  a { padding: 10px 20px; border-radius: 4px; text-decoration: none; color: var(--text-on-accent); font-weight: bold; }
  .login { background-color: #007bff; }
  .register { background-color: var(--success-solid); }
</style>

<BaseLayout title="Welcome">
  <h1>Welcome to the Communicator App</h1>
  <div>
    <a href="/login" class="login">Log In</a>
    <a href="/register" class="register">Register</a>
  </div>
</BaseLayout>
